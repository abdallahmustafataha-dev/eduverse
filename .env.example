# --- Supabase (shared with EduCo. — auth is CLOUD, same project) ------------
# The anon key is public by design; RLS protects the data. Never commit
# service_role. Both have working fallbacks in src/lib/supabase.ts.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Canonical origin --------------------------------------------------------
# Used for canonical/OG URLs, sitemap.xml and robots.txt. Set this in the
# Cloudflare Pages build environment, otherwise the build falls back to the
# default below and warns.
SITE_URL=https://eduverse-eg.pages.dev
# For local dev:
# SITE_URL=http://localhost:4321

# --- Optional ----------------------------------------------------------------
# Cloudflare Web Analytics token (checklist A18). When set, BaseLayout injects
# the beacon; when unset, no analytics script is shipped at all.
PUBLIC_CF_BEACON_TOKEN=

# Founder portrait path (brief/01 section 3). Unset, the designed monogram
# placeholder is used. Drop the file in public/ and point at it here.
PUBLIC_FOUNDER_PORTRAIT=
