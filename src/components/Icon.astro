---
/* Hand-rolled 24x24 stroke icons. Inline SVG keeps the request count at zero
   and lets every glyph inherit currentColor for light/dark themes. */
import type { IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  flip?: boolean;
  class?: string;
}

const paths = {
  home: 'M3 10.6 12 3.2l9 7.4M5.6 9.4V19a2 2 0 0 0 2 2h2.6v-5.4h3.6V21h2.6a2 2 0 0 0 2-2V9.4',
  search: 'M11 4.6a6.4 6.4 0 1 0 0 12.8 6.4 6.4 0 0 0 0-12.8ZM15.8 15.8 20.2 20.2',
  continue: 'M12 3.4a8.6 8.6 0 1 0 0 17.2 8.6 8.6 0 0 0 0-17.2ZM10.2 8.2 15.6 12l-5.4 3.8Z',
  quiz: 'M4 6.4 5.2 7.6 7.6 5M4 12 5.2 13.2 7.6 10.6M4 17.6 5.2 18.8 7.6 16.2M11 6.6h9M11 12h9M11 17.4h6',
  flashcards:
    'M12 3.2 21 7.6 12 12 3 7.6l9-4.4ZM3 12.4l9 4.4 9-4.4M3 16.8l9 4.4 9-4.4',
  badge: 'M12 3.6a5.4 5.4 0 1 0 0 10.8 5.4 5.4 0 0 0 0-10.8ZM8.4 13.2 7 21l5-2.6 5 2.6-1.4-7.8',
  leaderboard: 'M5.4 20.4V11M12 20.4V4.6M18.6 20.4v-6',
  grade:
    'M12 3.6 2.6 8.4 12 13.2l9.4-4.8L12 3.6ZM6.4 10.6v5.2c0 1.6 2.8 2.9 5.6 2.9s5.6-1.3 5.6-2.9v-5.2',
  subjects:
    'M4 5.8A2.2 2.2 0 0 1 6.2 3.6H20v15.2H6.2A2.2 2.2 0 0 0 4 21V5.8ZM20 16.6H6.2',
  parent:
    'M9.4 5a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2ZM2.8 20.4c0-3.5 2.9-5.8 6.6-5.8s6.6 2.3 6.6 5.8M16.2 5.2a3.6 3.6 0 0 1 0 6.6M18 20.4c0-2.2-1-4-2.6-5',
  settings:
    'M4 7h5.6M14.4 7H20M4 12h8.6M17.4 12H20M4 17h1.6M10.4 17H20',
  logout:
    'M14.6 4.2h3.2a2 2 0 0 1 2 2v11.6a2 2 0 0 1-2 2h-3.2M9.6 8.4 5.8 12l3.8 3.6M6 12h9.2',
  chevron: 'M9.4 5.6 15.8 12l-6.4 6.4',
  spark: 'M12 3.4 13.9 9l5.6 1.9-5.6 1.9L12 18.4 10.1 12.8 4.5 10.9 10.1 9 12 3.4Z',
  clock: 'M12 3.6a8.4 8.4 0 1 0 0 16.8 8.4 8.4 0 0 0 0-16.8ZM12 7.2V12l3.2 2',
  book: 'M5 4.4h11.4A2.6 2.6 0 0 1 19 7v12.6H7.6A2.6 2.6 0 0 0 5 22.2V4.4ZM19 19.6H7.6',
  menu: 'M4 7.2h16M4 12h16M4 16.8h16',
} as const;

/* Icons that need a knob/dot on top of their stroke path. */
const circles: Partial<Record<IconName, Array<[number, number, number]>>> = {
  settings: [
    [12, 7, 2],
    [15, 12, 2],
    [8, 17, 2],
  ],
};

const { name, size = 20, flip = false, class: className = '' } = Astro.props;
const d = paths[name];
---

<svg
  class:list={['icon', flip && 'icon--flip', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d}></path>
  {circles[name]?.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r}></circle>)}
</svg>
