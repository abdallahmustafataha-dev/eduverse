---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../lib/copy';

const copy = getDictionary('en');
const t = (key: string) => copy[key as keyof typeof copy];

const PARAGRAPHS = ['legal.termsP1', 'legal.termsP2', 'legal.termsP3', 'legal.termsP4'];
---

<BaseLayout
  locale="en"
  title={t('meta.termsTitle')}
  description={t('legal.termsLead')}
  pathname="/en/terms/"
>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">{t('nav.home')}</p>
        <h1>{t('legal.termsTitle')}</h1>
        <p class="section__lead">{t('legal.termsLead')}</p>
        <p class="todo-note">{t('legal.placeholderNote')}</p>
      </div>

      <div class="prose">
        {PARAGRAPHS.map((key) => <p>{t(key)}</p>)}
      </div>
    </div>
  </section>
</BaseLayout>
