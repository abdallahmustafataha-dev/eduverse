---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../lib/copy';

const copy = getDictionary('en');
const t = (key: string) => copy[key as keyof typeof copy];
---

<BaseLayout
  locale="en"
  title={t('meta.privacyTitle')}
  description={t('legal.privacyBody')}
  pathname="/en/privacy/"
>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">{t('nav.home')}</p>
        <h1>{t('legal.privacyTitle')}</h1>
      </div>

      <div class="prose">
        <p>{t('legal.privacyBody')}</p>
      </div>
    </div>
  </section>
</BaseLayout>
