---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../lib/copy';

const copy = getDictionary('ar');
const t = (key: string) => copy[key as keyof typeof copy];

const EMAIL = 'abdallah.mustafa.taha@gmail.com';
---

<BaseLayout
  locale="ar"
  title={t('meta.contactTitle')}
  description={t('legal.contactBody')}
  pathname="/ar/contact/"
>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">{t('nav.home')}</p>
        <h1>{t('legal.contactTitle')}</h1>
      </div>

      <div class="prose">
        <p>{t('legal.contactBody')}</p>
      </div>

      <div class="card empty-state">
        <p class="empty-state__title">{t('legal.contactEmailLabel')}</p>
        <p>
          <a class="link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
