---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../lib/copy';

const copy = getDictionary('ar');
const t = (key: string) => copy[key as keyof typeof copy];
---

<BaseLayout
  locale="ar"
  title={t('meta.termsTitle')}
  description={t('legal.termsBody')}
  pathname="/ar/terms/"
>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">{t('nav.home')}</p>
        <h1>{t('legal.termsTitle')}</h1>
      </div>

      <div class="prose">
        <p>{t('legal.termsBody')}</p>
      </div>
    </div>
  </section>
</BaseLayout>
