---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../lib/copy';

const copy = getDictionary('ar');
const t = (key: string) => copy[key as keyof typeof copy];

const PARAGRAPHS = ['legal.privacyP1', 'legal.privacyP2', 'legal.privacyP3', 'legal.privacyP4'];
---

<BaseLayout
  locale="ar"
  title={t('meta.privacyTitle')}
  description={t('legal.privacyLead')}
  pathname="/ar/privacy/"
>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">{t('nav.home')}</p>
        <h1>{t('legal.privacyTitle')}</h1>
        <p class="section__lead">{t('legal.privacyLead')}</p>
        <p class="todo-note">{t('legal.placeholderNote')}</p>
      </div>

      <div class="prose">
        {PARAGRAPHS.map((key) => <p>{t(key)}</p>)}
      </div>
    </div>
  </section>
</BaseLayout>
