---
import AuthLayout from '../../layouts/AuthLayout.astro';
import AuthPanel from '../../components/AuthPanel.astro';
import { getDictionary } from '../../lib/copy';

const copy = getDictionary('ar');
const t = (key: string) => copy[key as keyof typeof copy];
---

<AuthLayout
  locale="ar"
  title={t('meta.signupTitle')}
  pathname="/ar/signup/"
  eyebrow={t('auth.eyebrow')}
  heading={t('auth.signup.title')}
  sub={t('auth.signup.sub')}
>
  <AuthPanel locale="ar" mode="signup" />
</AuthLayout>
