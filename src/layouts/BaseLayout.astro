---
import '../styles/tokens.css';
import { getDictionary } from '../lib/copy';
import { absoluteUrl, type Locale } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  locale?: Locale;
  title: string;
  description?: string;
  /** Absolute or site-relative path of the current page, for canonical + OG. */
  pathname?: string;
  compactHeader?: boolean;
  showFooter?: boolean;
  showCookieBanner?: boolean;
  /** Sticky mobile CTA label; omit to hide. */
  stickyCtaHref?: string;
  stickyCtaLabel?: string;
  bodyClass?: string;
}

const {
  locale = 'en',
  title,
  description,
  pathname = typeof Astro.url !== 'undefined' ? Astro.url.pathname : '/',
  compactHeader = false,
  showFooter = true,
  showCookieBanner = true,
  stickyCtaHref,
  stickyCtaLabel,
  bodyClass = '',
} = Astro.props;

const copy = getDictionary(locale);
const desc = description || copy['meta.description'];
const canonical = absoluteUrl(pathname);
const ogImage = absoluteUrl('/og-image.png');
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F5F1E8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#7F1D1D" media="(prefers-color-scheme: dark)" />

    <!-- Favicon set (checklist A6) -->
    <link rel="icon" type="image/svg+xml" href="/eduverse-logos/eduverse-light.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="EduVerse" />
    <meta name="apple-mobile-web-app-title" content="EduVerse" />

    <!-- Open Graph (checklist A5) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EduVerse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy['hero.logoAlt']} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_EG' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Apply the stored theme before first paint so there is no flash. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
      } catch {}
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{copy['nav.skipContent']}</a>
    <Header locale={locale} compact={compactHeader} />
    <main id="main-content">
      <slot />
    </main>
    {showFooter && <Footer locale={locale} />}
    {showCookieBanner && <CookieBanner locale={locale} />}
    {
      stickyCtaHref && stickyCtaLabel && (
        <div class="sticky-cta">
          <a class="btn btn--primary btn--lg" href={stickyCtaHref}>
            {stickyCtaLabel}
          </a>
        </div>
      )
    }
    <script>
      import { initSite } from '../lib/site';
      initSite();
      if (document.querySelector('.sticky-cta')) {
        document.body.classList.add('has-sticky-cta');
      }
    </script>
    {
      beacon && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beacon })}
        />
      )
    }
  </body>
</html>
